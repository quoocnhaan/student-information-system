# Set by the deployment environment.
KNOWLEDGE_ENVIRONMENT=development
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_SURREAL_ENABLED=false
KNOWLEDGE_SURREAL_APPLY_SCHEMA_ON_STARTUP=false

# Port 8000 is commonly used by FastAPI; local compose maps SurrealDB to 8001.
SURREAL_URL=ws://localhost:8001
SURREAL_USER=root
SURREAL_PASSWORD=root

SURREAL_NAMESPACE=student_information
SURREAL_DATABASE=knowledge

# Local MinIO only. Replace both values outside local development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=knowledge-assets
MINIO_SECURE=false

# LM Studio OpenAI-compatible server. The worker's Docker URL is configured below.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_OCR_MODEL=lightonocr-2-1b
LMSTUDIO_CHAT_MODEL=qwen2.5-14b-instruct
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# OCR worker safeguards. Compose forwards these values to WORKER_* settings.
KNOWLEDGE_OCR_MAX_PAGES=100
KNOWLEDGE_OCR_MAX_OUTPUT_TOKENS=4096
KNOWLEDGE_OCR_TIMEOUT_SECONDS=60

# The central job service owns its own database and RabbitMQ publisher.
JOB_SURREAL_USER=jobroot
JOB_SURREAL_PASSWORD=change-me-job-db
JOB_WORKER_TOKEN=change-me-worker-job-token
JOB_OWNER_TOKENS_JSON={"knowledge":"change-me-knowledge-owner-token"}
KNOWLEDGE_JOB_SERVICE_OWNER_TOKEN=change-me-knowledge-owner-token
KNOWLEDGE_WORKER_CALLBACK_TOKEN=change-me-knowledge-worker-token
KNOWLEDGE_JOB_SERVICE_URL=http://localhost:8010
JOB_REGISTERED_TYPES=knowledge:ocr_pdf
JOB_REPLAY_BATCH_SIZE=100
WORKER_ENABLED_HANDLERS=knowledge:ocr_pdf
WORKER_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# RabbitMQ carries versioned job triggers; job-service scans queued rows on
# its first successful broker connection and after reconnects.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Dedicated cleanup process only. Keep dry-run enabled until candidates are verified.
KNOWLEDGE_ORPHAN_CLEANUP_ENABLED=false
KNOWLEDGE_ORPHAN_CLEANUP_GRACE_SECONDS=86400
KNOWLEDGE_ORPHAN_CLEANUP_INTERVAL_SECONDS=3600
KNOWLEDGE_ORPHAN_CLEANUP_DRY_RUN=true

# Optional until the parent application provides its user-auth integration.
# When set, WebSockets require Authorization: Bearer <value> (or access_token).
KNOWLEDGE_WEBSOCKET_AUTH_TOKEN=
KNOWLEDGE_WEBSOCKET_HEARTBEAT_SECONDS=20
# Optional metrics port for the Knowledge orphan-cleanup process.
KNOWLEDGE_METRICS_PORT=
