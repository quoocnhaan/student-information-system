# Copy this file to .env at the repository root and fill in blank secrets.
# Run Compose from the root with --env-file .env -f deploy/docker-compose.yml.

MYSQL_ROOT_PASSWORD=
# Shared credentials for Academic, Activity, and Enrollment databases.
SPRING_DATASOURCE_USERNAME=sis
SPRING_DATASOURCE_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=
JWT_EXPIRATION=14400000

# Fixed API/MySQL ports are defined by AGENTS.md.
# Academic: 8003 / 3303; Activity: 8004 / 3304; Enrollment: 8005 / 3305.
# MySQL containers use port 3306 internally; these are host ports.
ADMIN_WEB_PORT=5173
STUDENT_WEB_PORT=5174
MLEARNING_WEB_PORT=5175

# AI storage and broker credentials.
KNOWLEDGE_ENVIRONMENT=development
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_SURREAL_ENABLED=false
KNOWLEDGE_SURREAL_APPLY_SCHEMA_ON_STARTUP=false
# SurrealDB is internal to Docker; Compose sets this address for API/workers.
SURREAL_URL=ws://surrealdb:8000
SURREAL_USER=root
SURREAL_PASSWORD=
SURREAL_NAMESPACE=student_information
SURREAL_DATABASE=knowledge
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=knowledge-assets
MINIO_SECURE=false
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

KNOWLEDGE_RABBITMQ_USER=knowledge
KNOWLEDGE_RABBITMQ_PASSWORD=
KNOWLEDGE_WORKER_QUEUES=ocr
# Direct Python processes read this; Compose supplies its internal broker URL.
KNOWLEDGE_RABBITMQ_URL=amqp://${KNOWLEDGE_RABBITMQ_USER}:${KNOWLEDGE_RABBITMQ_PASSWORD}@localhost:5672/knowledge
KNOWLEDGE_JOB_REPLAY_BATCH_SIZE=100

# Docker containers reach LM Studio through the Windows host.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_OCR_MODEL=lightonocr-2-1b
LMSTUDIO_CHAT_MODEL=qwen2.5-14b-instruct
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
KNOWLEDGE_OCR_MAX_PAGES=100
KNOWLEDGE_OCR_MAX_OUTPUT_TOKENS=4096
KNOWLEDGE_OCR_TIMEOUT_SECONDS=60
KNOWLEDGE_CORRECTION_TIMEOUT_SECONDS=120
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
# Existing local setting retained and documented during environment consolidation.
KNOWLEDGE_CHUNK_MAX_TOKENS=
KNOWLEDGE_WEBSOCKET_AUTH_TOKEN=
KNOWLEDGE_WEBSOCKET_HEARTBEAT_SECONDS=20
KNOWLEDGE_METRICS_PORT=

# Dedicated cleanup process only; keep dry-run enabled while checking candidates.
KNOWLEDGE_ORPHAN_CLEANUP_ENABLED=false
KNOWLEDGE_ORPHAN_CLEANUP_DRY_RUN=true
KNOWLEDGE_ORPHAN_CLEANUP_GRACE_SECONDS=86400
KNOWLEDGE_ORPHAN_CLEANUP_INTERVAL_SECONDS=3600

# Worker deadlines in seconds (positive); customize these in .env.
KNOWLEDGE_DATABASE_TIMEOUT_SECONDS=30
KNOWLEDGE_INDEX_COMMIT_TIMEOUT_SECONDS=120
KNOWLEDGE_FAILURE_TIMEOUT_SECONDS=60
KNOWLEDGE_STARTUP_RECOVERY_TIMEOUT_SECONDS=120
KNOWLEDGE_OCR_PROCESSING_TIMEOUT_SECONDS=7200
KNOWLEDGE_CORRECTION_PROCESSING_TIMEOUT_SECONDS=14400
KNOWLEDGE_INDEX_PROCESSING_TIMEOUT_SECONDS=3600
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=120
# Required when running a worker directly; distinct for each replica.
# KNOWLEDGE_WORKER_ID=knowledge-index-1

# Stable Compose identities; use distinct values for additional replicas.
KNOWLEDGE_OCR_WORKER_ID=knowledge-ocr-1
KNOWLEDGE_CORRECT_WORKER_ID=knowledge-correct-1
KNOWLEDGE_INDEX_WORKER_ID=knowledge-index-1

